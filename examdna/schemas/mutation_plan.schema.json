{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examdna.local/schemas/mutation_plan.schema.json",
  "title": "ExamDNA mutation plan",
  "description": "Schema version 0.1.0. A reproducible set of mutation specifications.",
  "type": "object",
  "required": ["schema_version", "plan_id", "seed", "mode", "specs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "plan_id": {"type": "string"},
    "seed": {"type": "integer"},
    "mode": {"enum": ["conservative", "balanced", "exploratory"]},
    "specs": {"type": "array", "items": {"type": "object"}, "maxItems": 2000},
    "skipped": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
