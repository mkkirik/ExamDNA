{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examdna.local/schemas/genome.schema.json",
  "title": "ExamDNA question genome",
  "description": "Schema version 0.1.0. Structured representation of what a question assesses and how it is solved.",
  "type": "object",
  "required": ["schema_version", "genome_id", "question_id", "knowledge", "reasoning", "representation", "constraints", "assessment", "validation"],
  "additionalProperties": false,
  "definitions": {
    "string_list": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 50}
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.\\d+$"},
    "genome_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "question_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "parent_question_id": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {"enum": ["source", "agent_extracted", "generated"]},
        "document": {"type": ["string", "null"]},
        "page": {"type": ["string", "integer", "null"]}
      }
    },
    "lineage": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["question_id", "operator"],
        "additionalProperties": false,
        "properties": {
          "question_id": {"type": "string"},
          "operator": {"type": "string"},
          "spec_id": {"type": ["string", "null"]}
        }
      }
    },
    "knowledge": {
      "type": "object",
      "required": ["primary_concept"],
      "additionalProperties": false,
      "properties": {
        "primary_concept": {"type": ["string", "null"], "maxLength": 200},
        "secondary_concepts": {"$ref": "#/definitions/string_list"},
        "prerequisites": {"$ref": "#/definitions/string_list"},
        "learning_objectives": {"$ref": "#/definitions/string_list"},
        "topic": {"type": ["string", "null"]},
        "subtopic": {"type": ["string", "null"]}
      }
    },
    "reasoning": {
      "type": "object",
      "required": ["steps", "edges"],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
              "type": {"enum": ["read_given", "read_representation", "recall_fact", "identify_concept", "identify_constraint", "convert_units", "construct_model", "select_relation", "apply_mathematics", "derive_result", "compare", "interpret_result", "justify", "evaluate"]},
              "description": {"type": ["string", "null"], "maxLength": 500}
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 120,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}
        },
        "expected_inference": {"type": ["string", "null"], "maxLength": 1000},
        "justification_required": {"type": "boolean"}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {"type": "array", "items": {"enum": ["verbal", "table", "graph", "equation", "diagram", "symbolic", "data_set"]}, "uniqueItems": true},
        "output": {"type": "array", "items": {"enum": ["verbal", "table", "graph", "equation", "diagram", "symbolic", "data_set", "numeric"]}, "uniqueItems": true},
        "context": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explicit": {"$ref": "#/definitions/string_list"},
        "implicit": {"$ref": "#/definitions/string_list"},
        "domain": {"$ref": "#/definitions/string_list"},
        "boundary": {"$ref": "#/definitions/string_list"},
        "units": {"$ref": "#/definitions/string_list"},
        "precision": {"type": ["string", "null"], "maxLength": 100}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_term": {"type": ["string", "null"]},
        "question_type": {"type": ["string", "null"]},
        "cognitive_level": {"type": ["string", "null"]},
        "max_marks": {"type": ["integer", "null"], "minimum": 0},
        "answer_type": {"enum": ["numeric", "choice", "short_text", "extended_text", "expression", "graph_sketch", "mixed", null]},
        "expected_answer": {"type": ["string", "null"], "maxLength": 2000},
        "answer_unit": {"type": ["string", "null"], "maxLength": 40},
        "marking_components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "marks"],
            "properties": {"description": {"type": "string"}, "marks": {"type": "integer", "minimum": 0}}
          }
        },
        "difficulty_features": {"type": "object"},
        "difficulty": {"type": "object"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structural_completeness": {"enum": ["complete", "partial", "minimal"]},
        "missing_components": {"type": "array", "items": {"type": "string"}},
        "solvability": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_VERIFIED"]},
        "answer_validation": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_VERIFIED"]},
        "uniqueness": {"enum": ["unique", "multiple", "not_applicable", "unknown"]},
        "human_review_required": {"type": "boolean"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "graph_errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "field_provenance": {"type": "object", "additionalProperties": {"enum": ["explicit", "inferred", "calculated", "unverified"]}},
    "extensions": {"type": "object"}
  }
}
