{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examdna.local/schemas/question.schema.json",
  "title": "ExamDNA normalized question",
  "description": "Schema version 0.1.0. One assessment item, either extracted from a source or generated by mutation.",
  "type": "object",
  "required": ["id", "text", "source", "provenance"],
  "additionalProperties": false,
  "definitions": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "nullable_string": {"type": ["string", "null"], "maxLength": 2000},
    "provenance_kind": {"enum": ["explicit", "inferred", "calculated", "unverified"]},
    "marking_point": {
      "type": "object",
      "required": ["description", "marks"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "marks": {"type": "integer", "minimum": 0, "maximum": 100},
        "part": {"type": ["string", "null"], "maxLength": 20}
      }
    }
  },
  "properties": {
    "id": {"$ref": "#/definitions/id"},
    "schema_version": {"type": "string"},
    "language": {"type": ["string", "null"], "maxLength": 20},
    "source": {
      "type": "object",
      "required": ["origin"],
      "additionalProperties": false,
      "properties": {
        "document": {"$ref": "#/definitions/nullable_string"},
        "page": {"type": ["string", "integer", "null"]},
        "section": {"$ref": "#/definitions/nullable_string"},
        "position": {"type": ["integer", "null"], "minimum": 0},
        "origin": {"enum": ["source", "agent_extracted", "generated"]}
      }
    },
    "subject": {"$ref": "#/definitions/nullable_string"},
    "topic": {"$ref": "#/definitions/nullable_string"},
    "subtopic": {"$ref": "#/definitions/nullable_string"},
    "text": {"type": "string", "minLength": 1, "maxLength": 20000},
    "question_type": {"enum": ["multiple_choice", "short_answer", "calculation", "extended_response", "data_interpretation", "diagram_interpretation", "graph_interpretation", "mixed", null]},
    "marks": {"type": ["integer", "null"], "minimum": 0, "maximum": 500},
    "section": {"$ref": "#/definitions/nullable_string"},
    "learning_objectives": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 50},
    "cognitive_level": {"enum": ["recall", "interpretation", "application", "multi_step_reasoning", "evaluation", "synthesis", null]},
    "given": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["symbol"],
        "additionalProperties": false,
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"},
          "description": {"type": ["string", "null"], "maxLength": 300},
          "value": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"], "maxLength": 40},
          "role": {"enum": ["data", "distractor", "constant", null]}
        }
      }
    },
    "required_output": {"$ref": "#/definitions/nullable_string"},
    "constraints": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 500},
          "var": {"type": ["string", "null"], "maxLength": 32},
          "op": {"enum": ["<", "<=", ">", ">=", "==", "!=", null]},
          "value": {"type": ["number", "null"]},
          "kind": {"enum": ["explicit", "implicit", "domain", "boundary", "units", "precision", null]}
        }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["key", "text"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Za-z0-9]{1,3}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "parts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "maxLength": 20},
          "text": {"type": "string", "minLength": 1, "maxLength": 5000},
          "marks": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "answer_space_lines": {"type": ["integer", "null"], "minimum": 0, "maximum": 60}
        }
      }
    },
    "table": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "caption": {"type": ["string", "null"], "maxLength": 300},
        "columns": {"type": "array", "items": {"type": "string", "maxLength": 100}, "maxItems": 20},
        "rows": {"type": "array", "maxItems": 100, "items": {"type": "array", "maxItems": 20, "items": {"type": ["string", "number", "null"]}}}
      }
    },
    "diagram_description": {"$ref": "#/definitions/nullable_string"},
    "marking": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "scheme_available": {"type": "boolean"},
        "final_answer": {"type": ["string", "null"], "maxLength": 2000},
        "answer_key": {"type": ["string", "null"], "maxLength": 3},
        "worked_solution": {"type": ["string", "null"], "maxLength": 10000},
        "points": {"type": "array", "items": {"$ref": "#/definitions/marking_point"}, "maxItems": 60},
        "accept_rule": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "difficulty_features": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reasoning_stages": {"type": "integer", "minimum": 0, "maximum": 30},
        "prerequisite_count": {"type": "integer", "minimum": 0, "maximum": 30},
        "math_complexity": {"type": "integer", "minimum": 0, "maximum": 3},
        "interacting_constraints": {"type": "integer", "minimum": 0, "maximum": 30},
        "representation_count": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "extraction_confidence": {"enum": ["high", "medium", "low", null]},
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document": {"type": ["string", "null"], "maxLength": 300},
          "page": {"type": ["string", "integer", "null"]},
          "quote": {"type": ["string", "null"], "maxLength": 300}
        }
      }
    },
    "review_status": {"enum": ["unreviewed", "needs_review", "human_reviewed"]},
    "provenance": {"type": "object", "additionalProperties": {"$ref": "#/definitions/provenance_kind"}},
    "missing_fields": {"type": "array", "items": {"type": "string"}},
    "security_flags": {"type": "array", "items": {"type": "string"}},
    "lineage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "parent_id": {"$ref": "#/definitions/id"},
        "root_id": {"$ref": "#/definitions/id"},
        "operator": {"type": "string"},
        "spec_id": {"type": ["string", "null"]},
        "candidate_id": {"type": ["string", "null"]},
        "generation": {"type": "integer", "minimum": 1, "maximum": 20},
        "mutation_parameters": {"type": "object"},
        "preserved": {"type": "array", "items": {"type": "string"}},
        "changed": {"type": "array", "items": {"type": "string"}},
        "created": {"type": ["string", "null"]}
      }
    },
    "validation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_VERIFIED"]},
        "summary": {"type": ["string", "null"]},
        "model_assisted": {"type": "boolean"},
        "numeric_verified": {"type": "boolean"}
      }
    },
    "extensions": {"type": "object"}
  }
}
