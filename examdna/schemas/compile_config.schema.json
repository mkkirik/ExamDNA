{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examdna.local/schemas/compile_config.schema.json",
  "title": "ExamDNA compiler configuration",
  "description": "Schema version 0.1.0. Hard and soft constraints for assembling an exam.",
  "type": "object",
  "required": ["total_marks"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "maxLength": 200},
    "subject": {"type": ["string", "null"], "maxLength": 200},
    "language": {"enum": ["en", "tr"]},
    "total_marks": {"type": "integer", "minimum": 1, "maximum": 500},
    "question_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 200},
    "time_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 600},
    "instructions": {"type": "array", "items": {"type": "string", "maxLength": 500}},
    "sections": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["label", "marks"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "maxLength": 20},
          "title": {"type": ["string", "null"], "maxLength": 200},
          "instructions": {"type": ["string", "null"], "maxLength": 500},
          "marks": {"type": "integer", "minimum": 1},
          "question_count": {"type": ["integer", "null"], "minimum": 1},
          "min_questions": {"type": ["integer", "null"], "minimum": 0},
          "max_questions": {"type": ["integer", "null"], "minimum": 1},
          "allowed_types": {"type": "array", "items": {"type": "string"}},
          "source_sections": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "allowed_topics": {"type": "array", "items": {"type": "string"}},
    "excluded_topics": {"type": "array", "items": {"type": "string"}},
    "required_topics": {"type": "array", "items": {"type": "string"}},
    "required_types": {"type": "array", "items": {"type": "string"}},
    "difficulty_target": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "foundation": {"type": "number", "minimum": 0},
        "standard": {"type": "number", "minimum": 0},
        "challenging": {"type": "number", "minimum": 0}
      }
    },
    "difficulty_shift": {"type": "integer", "minimum": -2, "maximum": 2},
    "max_per_family": {"type": "integer", "minimum": 1, "maximum": 20},
    "include_review_required": {"type": "boolean"},
    "include_source_questions": {"type": "boolean"},
    "seed": {"type": "integer"},
    "search_budget": {"type": "integer", "minimum": 100, "maximum": 5000000},
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {"type": "number", "minimum": 0},
        "cognitive": {"type": "number", "minimum": 0},
        "difficulty": {"type": "number", "minimum": 0},
        "question_type": {"type": "number", "minimum": 0},
        "family_repeat": {"type": "number", "minimum": 0},
        "question_count": {"type": "number", "minimum": 0}
      }
    }
  }
}
